<Window x:Class="_08_Task.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:_08_Task"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <DockPanel>
        <Grid DockPanel.Dock="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Label Margin="5" FontSize="16" FontWeight="Bold">Url addres: </Label>
            <TextBox x:Name="MyTextBox" Margin="5" VerticalContentAlignment="Center" Grid.Column="1"></TextBox>
            <Button Margin="5" FontSize="16" FontWeight="Bold" Background="GreenYellow" Grid.Column="2" Click="Button_Select_Folder">Select Folder</Button>
            <Button Margin="5" FontSize="16" FontWeight="Bold" Background="GreenYellow" Grid.Column="3" Click="Button_Loading">Loading</Button>
            <Button Margin="5" FontSize="16" FontWeight="Bold" Background="GreenYellow" Width="70" Grid.Column="4" Click="Button_stop">Stop</Button>
        </Grid>
        <TextBlock HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="10" DockPanel.Dock="Top">Info</TextBlock>
        <ListBox SelectionChanged="MuListBox_SelectionChanged" Padding="30" x:Name="MuListBox"></ListBox>
    </DockPanel>
</Window>
